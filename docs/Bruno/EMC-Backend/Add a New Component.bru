meta {
  name: Add a New Component
  type: http
  seq: 3
}

post {
  url: http://localhost:8001/api/component
  body: json
  auth: inherit
}

headers {
  X-Api-key: emc-api-key
}

body:json {
  {  "components" : [
    {
      "type": "connector",
