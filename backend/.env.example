

# =========================================================
# Application
# =========================================================
APP_PORT=5000
APP_HOST=0.0.0.0

# =========================================================
# Database
# =========================================================
DATABASE_URL=postgresql://user:password@localhost:5432/edc_manager

# =========================================================
# API Authorization
# =========================================================
AUTH_ENABLED=true
API_KEY_HEADER=X-Api-Key
API_KEY_VALUE=your_secure_api_key_here

# =========================================================
# Keycloak / Central IDP
# =========================================================
KEYCLOAK_URL=keycloak_url
KEYCLOAK_REALM=CX-Central
KEYCLOAK_CLIENT_ID=CX-EDC
KEYCLOAK_CLIENT_SECRET=

# =========================================================
# Dataspace
# =========================================================
DATASPACE_AUTHORITY_ID=BPNL00000003CRHK

# =========================================================
# SSI Wallet
# =========================================================
SSI_WALLET_URL=ssi_wallet_url
SSI_WALLET_CLIENT_ID=your_client_id
SSI_WALLET_CLIENT_SECRET=your_client_secret

# =========================================================
# Portal
# =========================================================
PORTAL_URL=portal_url
PORTAL_CLIENT_ID=your_client_id
PORTAL_CLIENT_SECRET=your_client_secret

# =========================================================
# Discovery Services
# =========================================================
SEMANTICS_URL=semantics_url

DISCOVERY_FINDER_CLIENT_ID=your_client_id
DISCOVERY_FINDER_CLIENT_SECRET=your_client_secret

BPN_DISCOVERY_CLIENT_ID=your_client_id
BPN_DISCOVERY_CLIENT_SECRET=your_client_secret

# =========================================================
# Kubernetes Cluster
# =========================================================

CLUSTER_CONTEXT=cluster_context_name
CLUSTER_NAMESPACE=edc-management-console
# =========================================================
# SDE Configuration
# =========================================================

SDE_URL=sde_app_url
SDE_CLIENT_ID=SDE_ID
SDE_MANUFACTURER_ID=BPNL000000000

SDE_PROVIDER_EDC=sde_provider_edc_url
SDE_CONSUMER_EDC=sde_consumer_edc_url

SDE_REGISTRY_URL=sde_registry_url

# =========================================================
# EDC
# =========================================================
EDC_DEFAULT_URL=consumer_controlplane_url

EDC_HOSTNAME_CP=controlplane_url
EDC_HOSTNAME_DP=dataplane_url
